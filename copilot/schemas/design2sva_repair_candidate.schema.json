{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Design2SVA Repair Candidate",
  "type": "object",
  "required": [
    "property_id",
    "sva",
    "helper_code",
    "referenced_signals",
    "intent_summary",
    "repair_metadata",
    "source"
  ],
  "properties": {
    "property_id": { "type": "string", "minLength": 1 },
    "sva": { "type": "string", "minLength": 1 },
    "helper_code": { "type": "string" },
    "referenced_signals": {
      "type": "array",
      "items": { "type": "string" }
    },
    "intent_summary": { "type": "string" },
    "repair_metadata": {
      "type": "object",
      "required": ["round", "failure_category", "feedback", "changed_by_repair"],
      "properties": {
        "round": { "type": "integer", "minimum": 0 },
        "failure_category": { "type": "string" },
        "feedback": { "type": "string" },
        "changed_by_repair": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "source": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
