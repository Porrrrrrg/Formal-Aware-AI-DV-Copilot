{
  "$defs": {
    "ArtifactEncoding": {
      "description": "Payload encoding for an artifact.",
      "enum": [
        "json",
        "text",
        "binary"
      ],
      "title": "ArtifactEncoding",
      "type": "string"
    },
    "ArtifactKind": {
      "description": "Artifact roles stored outside the typed objects.",
      "enum": [
        "run_manifest",
        "problem_spec",
        "candidate",
        "verifier_outcome",
        "artifact_manifest",
        "stdout",
        "stderr",
        "proof_script",
        "smt2",
        "proof_object",
        "trace",
        "log",
        "report",
        "schema",
        "other"
      ],
      "title": "ArtifactKind",
      "type": "string"
    },
    "ArtifactManifest": {
      "additionalProperties": false,
      "description": "Index of artifacts produced by one run.",
      "properties": {
        "artifacts": {
          "items": {
            "$ref": "#/$defs/ArtifactRecord"
          },
          "title": "Artifacts",
          "type": "array"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "manifest_id": {
          "pattern": "^run_[0-9]{8}T[0-9]{6}Z_[a-f0-9]{12}_[a-z0-9]{6}$",
          "title": "Manifest Id",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "run_id": {
          "pattern": "^run_[0-9]{8}T[0-9]{6}Z_[a-f0-9]{12}_[a-z0-9]{6}$",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "v1",
          "default": "v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "manifest_id",
        "run_id",
        "generated_at"
      ],
      "title": "ArtifactManifest",
      "type": "object"
    },
    "ArtifactRecord": {
      "additionalProperties": false,
      "description": "Single content-addressed artifact entry.",
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "encoding": {
          "$ref": "#/$defs/ArtifactEncoding"
        },
        "key": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._=-]*(/[A-Za-z0-9][A-Za-z0-9._=-]*)*$",
          "title": "Key",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "path": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._=-]*(/[A-Za-z0-9][A-Za-z0-9._=-]*)*$",
          "title": "Path",
          "type": "string"
        },
        "producer": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Producer"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "key",
        "path",
        "kind",
        "sha256",
        "size_bytes",
        "media_type",
        "encoding",
        "created_at"
      ],
      "title": "ArtifactRecord",
      "type": "object"
    },
    "Candidate": {
      "additionalProperties": false,
      "description": "Generated candidate proof, query, or repair payload.",
      "properties": {
        "artifact_refs": {
          "items": {
            "type": "string"
          },
          "title": "Artifact Refs",
          "type": "array"
        },
        "attempt_id": {
          "pattern": "^attempt_[0-9]{4}$",
          "title": "Attempt Id",
          "type": "string"
        },
        "candidate_id": {
          "pattern": "^cand_[0-9]{4}_[a-z0-9][a-z0-9_-]{0,31}_[a-f0-9]{12}$",
          "title": "Candidate Id",
          "type": "string"
        },
        "content": {
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "content_type": {
          "default": "text/plain",
          "minLength": 1,
          "title": "Content Type",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "model": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "problem_id": {
          "pattern": "^problem_(lean|rocq|isabelle|z3|cvc5)_[a-f0-9]{12}$",
          "title": "Problem Id",
          "type": "string"
        },
        "producer": {
          "minLength": 1,
          "title": "Producer",
          "type": "string"
        },
        "run_id": {
          "pattern": "^run_[0-9]{8}T[0-9]{6}Z_[a-f0-9]{12}_[a-z0-9]{6}$",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "v1",
          "default": "v1",
          "title": "Schema Version",
          "type": "string"
        },
        "tokens_in": {
          "default": 0,
          "minimum": 0,
          "title": "Tokens In",
          "type": "integer"
        },
        "tokens_out": {
          "default": 0,
          "minimum": 0,
          "title": "Tokens Out",
          "type": "integer"
        }
      },
      "required": [
        "candidate_id",
        "run_id",
        "problem_id",
        "attempt_id",
        "producer",
        "content"
      ],
      "title": "Candidate",
      "type": "object"
    },
    "Diagnostic": {
      "additionalProperties": false,
      "description": "A normalized verifier diagnostic.",
      "properties": {
        "artifact_ref": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._=-]*(/[A-Za-z0-9][A-Za-z0-9._=-]*)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Ref"
        },
        "code": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Code"
        },
        "column": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Column"
        },
        "level": {
          "$ref": "#/$defs/DiagnosticLevel"
        },
        "line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "level",
        "message"
      ],
      "title": "Diagnostic",
      "type": "object"
    },
    "DiagnosticLevel": {
      "description": "Severity for tool diagnostics.",
      "enum": [
        "info",
        "warning",
        "error"
      ],
      "title": "DiagnosticLevel",
      "type": "string"
    },
    "ErrorKind": {
      "description": "Stable error taxonomy shared by adapters and orchestration.",
      "enum": [
        "invalid_input",
        "schema_drift",
        "unsupported_tool",
        "tool_not_found",
        "tool_timeout",
        "tool_crash",
        "adapter_error",
        "artifact_missing",
        "artifact_integrity",
        "internal_error"
      ],
      "title": "ErrorKind",
      "type": "string"
    },
    "ErrorRecord": {
      "additionalProperties": false,
      "description": "Machine-readable error payload for recoverable core failures.",
      "properties": {
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "kind": {
          "$ref": "#/$defs/ErrorKind"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "message"
      ],
      "title": "ErrorRecord",
      "type": "object"
    },
    "Language": {
      "description": "Source languages accepted by ProblemSpec.",
      "enum": [
        "lean",
        "rocq",
        "isabelle",
        "smt2"
      ],
      "title": "Language",
      "type": "string"
    },
    "ProblemSpec": {
      "additionalProperties": false,
      "description": "Tool-neutral statement plus context references for a verification task.",
      "properties": {
        "assumptions": {
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "context_refs": {
          "items": {
            "type": "string"
          },
          "title": "Context Refs",
          "type": "array"
        },
        "language": {
          "$ref": "#/$defs/Language"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "problem_id": {
          "pattern": "^problem_(lean|rocq|isabelle|z3|cvc5)_[a-f0-9]{12}$",
          "title": "Problem Id",
          "type": "string"
        },
        "schema_version": {
          "const": "v1",
          "default": "v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_url": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Url"
        },
        "statement": {
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "tool": {
          "$ref": "#/$defs/ToolName"
        }
      },
      "required": [
        "problem_id",
        "tool",
        "language",
        "statement"
      ],
      "title": "ProblemSpec",
      "type": "object"
    },
    "RunManifest": {
      "additionalProperties": false,
      "description": "Ledger for one replayable run or experiment iteration.",
      "properties": {
        "artifacts_key": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._=-]*(/[A-Za-z0-9][A-Za-z0-9._=-]*)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifacts Key"
        },
        "container_image": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Container Image"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "dataset_version": {
          "minLength": 1,
          "title": "Dataset Version",
          "type": "string"
        },
        "git_sha": {
          "maxLength": 64,
          "minLength": 7,
          "pattern": "^[A-Fa-f0-9]+$",
          "title": "Git Sha",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "model_snapshot": {
          "minLength": 1,
          "title": "Model Snapshot",
          "type": "string"
        },
        "problem_id": {
          "anyOf": [
            {
              "pattern": "^problem_(lean|rocq|isabelle|z3|cvc5)_[a-f0-9]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Problem Id"
        },
        "prompt_version": {
          "minLength": 1,
          "title": "Prompt Version",
          "type": "string"
        },
        "random_seed": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Random Seed"
        },
        "run_id": {
          "pattern": "^run_[0-9]{8}T[0-9]{6}Z_[a-f0-9]{12}_[a-z0-9]{6}$",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "v1",
          "default": "v1",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/RunStatus",
          "default": "queued"
        },
        "toolchain": {
          "$ref": "#/$defs/ToolchainVersions"
        }
      },
      "required": [
        "run_id",
        "created_at",
        "git_sha",
        "dataset_version",
        "prompt_version",
        "model_snapshot",
        "toolchain"
      ],
      "title": "RunManifest",
      "type": "object"
    },
    "RunStatus": {
      "description": "Lifecycle states for a run.",
      "enum": [
        "queued",
        "running",
        "blocked",
        "review",
        "passed",
        "failed",
        "canceled"
      ],
      "title": "RunStatus",
      "type": "string"
    },
    "ToolName": {
      "description": "Verifier tools supported by the core adapter contract.",
      "enum": [
        "lean",
        "rocq",
        "isabelle",
        "z3",
        "cvc5"
      ],
      "title": "ToolName",
      "type": "string"
    },
    "ToolchainVersions": {
      "additionalProperties": false,
      "description": "Version snapshot for target tools.",
      "properties": {
        "cvc5": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cvc5"
        },
        "isabelle": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Isabelle"
        },
        "lean": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lean"
        },
        "rocq": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rocq"
        },
        "z3": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Z3"
        }
      },
      "title": "ToolchainVersions",
      "type": "object"
    },
    "VerificationStatus": {
      "description": "Tool-normalized verification result.",
      "enum": [
        "passed",
        "failed",
        "unknown",
        "timeout",
        "error"
      ],
      "title": "VerificationStatus",
      "type": "string"
    },
    "VerifierOutcome": {
      "additionalProperties": false,
      "description": "Normalized result returned by every verifier adapter.",
      "properties": {
        "artifact_refs": {
          "items": {
            "type": "string"
          },
          "title": "Artifact Refs",
          "type": "array"
        },
        "attempt_id": {
          "pattern": "^attempt_[0-9]{4}$",
          "title": "Attempt Id",
          "type": "string"
        },
        "candidate_id": {
          "pattern": "^cand_[0-9]{4}_[a-z0-9][a-z0-9_-]{0,31}_[a-f0-9]{12}$",
          "title": "Candidate Id",
          "type": "string"
        },
        "diagnostics": {
          "items": {
            "$ref": "#/$defs/Diagnostic"
          },
          "title": "Diagnostics",
          "type": "array"
        },
        "elapsed_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Elapsed Ms"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorRecord"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "exit_code": {
          "title": "Exit Code",
          "type": "integer"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "ok": {
          "title": "Ok",
          "type": "boolean"
        },
        "outcome_id": {
          "pattern": "^verify_[0-9]{4}_(lean|rocq|isabelle|z3|cvc5)_[a-f0-9]{12}$",
          "title": "Outcome Id",
          "type": "string"
        },
        "problem_id": {
          "pattern": "^problem_(lean|rocq|isabelle|z3|cvc5)_[a-f0-9]{12}$",
          "title": "Problem Id",
          "type": "string"
        },
        "run_id": {
          "pattern": "^run_[0-9]{8}T[0-9]{6}Z_[a-f0-9]{12}_[a-z0-9]{6}$",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "v1",
          "default": "v1",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/VerificationStatus"
        },
        "stderr_ref": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._=-]*(/[A-Za-z0-9][A-Za-z0-9._=-]*)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stderr Ref"
        },
        "stdout_ref": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._=-]*(/[A-Za-z0-9][A-Za-z0-9._=-]*)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stdout Ref"
        },
        "timed_out": {
          "default": false,
          "title": "Timed Out",
          "type": "boolean"
        },
        "tool": {
          "$ref": "#/$defs/ToolName"
        }
      },
      "required": [
        "outcome_id",
        "run_id",
        "problem_id",
        "candidate_id",
        "attempt_id",
        "ok",
        "status",
        "tool",
        "exit_code"
      ],
      "title": "VerifierOutcome",
      "type": "object"
    }
  },
  "$id": "schemas/v1/core.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "$ref": "#/$defs/RunManifest"
    },
    {
      "$ref": "#/$defs/ProblemSpec"
    },
    {
      "$ref": "#/$defs/Candidate"
    },
    {
      "$ref": "#/$defs/VerifierOutcome"
    },
    {
      "$ref": "#/$defs/ArtifactManifest"
    }
  ],
  "title": "Formal Agent Core Schemas"
}
