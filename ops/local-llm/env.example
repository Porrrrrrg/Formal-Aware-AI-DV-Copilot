# Copy to .env and edit paths before starting a server.
# The scripts intentionally avoid hard-coded OS, driver, CUDA, or cuDNN versions.

# ---------------------------------------------------------------------------
# Local serving
# ---------------------------------------------------------------------------
LOCAL_ONLY=true
SERVING_BACKEND=vllm

# Reproducible profile names used by healthcheck manifests.
QWEN_PROFILE=safe_profile
QWEN_SAFE_PROFILE_MODEL=Qwen/Qwen3-14B-AWQ
QWEN_SAFE_PROFILE_QUANTIZATION=AWQ
QWEN_BIG_PROFILE_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
QWEN_BIG_PROFILE_QUANTIZATION=native_or_local_quantized
QWEN_EXPERIMENTAL_DENSE_PROFILE_MODEL=Qwen/Qwen3-32B-AWQ
QWEN_EXPERIMENTAL_DENSE_PROFILE_QUANTIZATION=AWQ

# Main model for a single RTX 3090 Ti. Leave empty to use QWEN_PROFILE.
# After model acquisition, set QWEN_MODEL to a local snapshot directory and
# SERVED_MODEL_NAME to the reproducible model/profile name exposed by the API.
QWEN_MODEL=
SERVED_MODEL_NAME=
ALLOW_MODEL_DOWNLOAD=false
MODEL_CACHE_DIR=/srv/local-llm/models

# Fast development local fallback for lower latency, CI smoke tests, or OOM recovery.
QWEN_FAST_MODEL=Qwen/Qwen3-8B-AWQ

# Bind only to localhost by default.
LLM_HOST=127.0.0.1
VLLM_PORT=8000
SGLANG_PORT=30000
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# 3090 Ti has 24 GB VRAM. These values are conservative first-run defaults.
# Raise MAX_MODEL_LEN to 32768 only after local manifests stay stable.
MAX_MODEL_LEN=24576
GPU_MEMORY_UTILIZATION=0.82
MAX_NUM_SEQS=1
DTYPE=auto
TENSOR_PARALLEL_SIZE=1

# Qwen3 thinking parser. For vLLM >= 0.9.0 use qwen3; older versions can use
# deepseek_r1. Leave empty to disable non-standard reasoning_content parsing.
REASONING_PARSER=qwen3
ENABLE_AUTO_TOOL_CHOICE=false
TOOL_CALL_PARSER=hermes

# Optional install step. Keep false on production/service starts.
INSTALL_DEPS=false
PYTHON_BIN=python3

# ---------------------------------------------------------------------------
# Filesystem layout
# ---------------------------------------------------------------------------
LOG_DIR=/var/log/local-llm
RUN_DIR=/var/run/local-llm
SERVICE_LOG_FILE=/var/log/local-llm/vllm.log
HEALTHCHECK_LOG=/var/log/local-llm/healthcheck.jsonl
QWEN_HEALTH_REPORTS_DIR=reports/local_llm

# ---------------------------------------------------------------------------
# JSON-only healthcheck policy
# ---------------------------------------------------------------------------
LOCAL_BASE_URL=http://127.0.0.1:8000/v1
LOCAL_API_KEY=EMPTY
BENCH_TIMEOUT_S=120
BENCH_MAX_TOKENS=512
BENCH_TEMPERATURE=0.0
VRAM_WARN_FRACTION=0.92
QWEN_HEALTH_PROMPT_VERSION=qwen-health-json-v1
QWEN_HEALTH_SCHEMA_VERSION=local-qwen-health/v1

# ---------------------------------------------------------------------------
# Cloud fallback
# ---------------------------------------------------------------------------
# Fallback is hard-disabled while LOCAL_ONLY=true. The healthcheck never calls
# cloud; it only records whether fallback would be allowed by policy.
# Never put a real key in this file; export it from the shell, secret manager,
# or CI secret store.
CLOUD_OPENAI_BASE_URL=https://api.openai.com/v1
CLOUD_OPENAI_API_KEY=
CLOUD_OPENAI_MODEL=
CLOUD_FALLBACK_ON_OOM=true
CLOUD_FALLBACK_ON_UNAVAILABLE=true
CLOUD_FALLBACK_ON_LOCAL_5XX=true
CLOUD_FALLBACK_ON_TIMEOUT=true
CLOUD_FALLBACK_ON_LATENCY_WARN=false
